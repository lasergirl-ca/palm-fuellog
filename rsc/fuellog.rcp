FORM ID EditServiceForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
    TITLE "Service Type"
    LABEL "Name:" AUTOID AT (28 17) FONT 0
    FIELD ID SvtNameField AT (58 17 98 12) UNDERLINED MAXCHARS 23
    LABEL "Every:" AUTOID AT (26 30) FONT 0
    FIELD ID SvtDistField AT (58 30 40 12) UNDERLINED MAXCHARS 6 NUMERIC
    LABEL "km   " ID SvtDistUnitLabel AT (101 30) FONT 0
    LABEL "or every:" AUTOID AT (14 43) FONT 0
    FIELD ID SvtMonthsField AT (58 43 24 12) UNDERLINED MAXCHARS 3 NUMERIC
    LABEL "months" AUTOID AT (85 43) FONT 0
    LABEL "Warn:" AUTOID AT (29 56) FONT 0
    FIELD ID SvtWarnDistField AT (58 56 34 12) UNDERLINED MAXCHARS 5 NUMERIC
    LABEL "km before    " ID SvtWarnUnitLabel AT (95 56) FONT 0
    LABEL "or:" AUTOID AT (42 69) FONT 0
    FIELD ID SvtWarnDaysField AT (58 69 24 12) UNDERLINED MAXCHARS 3 NUMERIC
    LABEL "days before" AUTOID AT (85 69) FONT 0
    CHECKBOX "Alarm when due" ID SvtAlarmCheckbox AT (56 82 90 12)
    LABEL "Detail:" AUTOID AT (26 95) FONT 0
    FIELD ID SvtDetailField AT (58 95 98 12) UNDERLINED MAXCHARS 31
    LABEL "                                        " ID SvtSummary1 AT (4 113) FONT 0
    LABEL "                                        " ID SvtSummary2 AT (4 124) FONT 0
    LABEL "                                        " ID SvtSummary3 AT (4 135) FONT 0
    BUTTON "Done" ID SvtDoneButton AT (4 146 36 12)
    BUTTON "Cancel" ID SvtCancelButton AT (46 146 40 12)
    BUTTON "Archive" ID SvtArchiveButton AT (108 146 48 12)
    SCROLLBAR ID SvtScrollBar AT (153 15 7 130) VALUE 0 MIN 0 MAX 0 PAGESIZE 100
END

FORM ID LogServiceForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
    TITLE "Log Service"
    LABEL "Date:" AUTOID AT (32 17) FONT 0
    SELECTORTRIGGER "Oct 22" ID SvlDateTrigger AT (58 17 44 12)
    LABEL "Odometer:" AUTOID AT (12 30) FONT 0
    FIELD ID SvlOdoField AT (58 30 50 12) UNDERLINED MAXCHARS 10 NUMERIC
    LABEL "from last fill" ID SvlOdoHint AT (111 30) FONT 0
    LABEL "Done at this visit" ID SvlDoneLabel AT (4 43) FONT 1
    CHECKBOX "                       " ID 2810 AT (12 56 140 12)
    CHECKBOX "                       " ID 2811 AT (12 68 140 12)
    CHECKBOX "                       " ID 2812 AT (12 80 140 12)
    CHECKBOX "                       " ID 2813 AT (12 92 140 12)
    CHECKBOX "                       " ID 2814 AT (12 104 140 12)
    CHECKBOX "                       " ID 2815 AT (12 116 140 12)
    CHECKBOX "                       " ID 2816 AT (12 128 140 12)
    CHECKBOX "                       " ID 2817 AT (12 140 140 12)
    CHECKBOX "                       " ID 2818 AT (12 152 140 12)
    CHECKBOX "                       " ID 2819 AT (12 164 140 12)
    CHECKBOX "                       " ID 2820 AT (12 176 140 12)
    CHECKBOX "                       " ID 2821 AT (12 188 140 12)
    CHECKBOX "Other:" ID SvlOtherCheckbox AT (12 200 40 12)
    FIELD ID SvlOtherField AT (54 200 102 12) UNDERLINED MAXCHARS 23
    LABEL "Cost:" ID SvlCostLabel AT (32 213) FONT 0
    FIELD ID SvlCostField AT (58 213 44 12) UNDERLINED MAXCHARS 9 NUMERIC
    POPUPTRIGGER "CAD" ID SvlCurrencyTrigger AT (106 213 44 12) LEFTANCHOR
    LIST "USD" "CAD" "EUR" "AUD" ID SvlCurrencyList AT (106 213 44 44) NONUSABLE VISIBLEITEMS 4
    POPUPLIST ID SvlCurrencyTrigger SvlCurrencyList
    LABEL "Paid:" ID SvlPaidLabel AT (33 226) FONT 0
    PUSHBUTTON "Cash" ID SvlCashButton AT (58 226 30 12) GROUP 1
    PUSHBUTTON "Card" ID SvlCardButton AT (PREVRIGHT 226 30 12) GROUP 1
    LABEL "Shop:" ID SvlShopLabel AT (30 239) FONT 0
    FIELD ID SvlShopField AT (58 239 98 12) UNDERLINED MAXCHARS 23
    LABEL "Detail:" ID SvlDetailLabel AT (26 252) FONT 0
    FIELD ID SvlDetailField AT (58 252 98 12) UNDERLINED MAXCHARS 31
    LABEL "                                        " ID SvlNextLabel AT (4 265) FONT 0
    BUTTON "Done" ID SvlDoneButton AT (4 280 36 12)
    BUTTON "Cancel" ID SvlCancelButton AT (46 280 40 12)
    BUTTON "Note" ID SvlNoteButton AT (92 280 34 12)
    BUTTON "Delete" ID SvlDeleteButton AT (118 280 38 12)
    SCROLLBAR ID SvlScrollBar AT (153 15 7 130) VALUE 0 MIN 0 MAX 0 PAGESIZE 100
END

ALERT ID NeedServiceNameAlert
ERROR
BEGIN
    TITLE "Name the service"
    MESSAGE "Give the service a name, such as Oil and filter."
    BUTTONS "OK"
END

ALERT ID DeleteServiceAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
    TITLE "Delete service?"
    MESSAGE "No visit covers this service, so nothing else is lost."
    BUTTONS "Delete" "Cancel"
END

ALERT ID NothingDoneAlert
ERROR
BEGIN
    TITLE "Nothing ticked"
    MESSAGE "Tick what was done at this visit, or Other with a few words."
    BUTTONS "OK"
END

ALERT ID TooManyServicesAlert
ERROR
BEGIN
    TITLE "Service limit"
    MESSAGE "A vehicle keeps up to 31 service types. Archive one first."
    BUTTONS "OK"
END

FORM ID HistoryForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
    TITLE "History"
    BUTTON "Done" ID HistDoneButton AT (4 146 36 12)
    BUTTON "Intervals" ID HistIntervalsButton AT (46 146 48 12)
    SCROLLBAR ID HistScrollBar AT (152 15 7 130) VALUE 0 MIN 0 MAX 0 PAGESIZE 100
END

ALERT ID DeleteVisitAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
    TITLE "Delete this visit?"
    MESSAGE "The services it covered will count from the visit before it."
    BUTTONS "Delete" "Cancel"
END

ALERT ID ServiceAlarmAlert
INFORMATION
BEGIN
    TITLE "FuelLog: service due"
    MESSAGE "A service reaches its due date today. Open FuelLog and tap Service for details."
    BUTTONS "OK"
END

ALERT ID ServiceDueAlert
INFORMATION
BEGIN
    TITLE "Service coming up"
    MESSAGE "^1. Tap Service on the fill list for details."
    BUTTONS "OK"
END

FORM ID ReportsForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
    TITLE "Reports"
    POPUPTRIGGER "All vehicles" ID RptVehicleTrigger AT (96 1 62 12) RIGHTANCHOR
    LIST "All vehicles" ID RptVehicleList AT (60 1 98 60) NONUSABLE VISIBLEITEMS 6
    POPUPLIST ID RptVehicleTrigger RptVehicleList
    POPUPTRIGGER "Monthly" ID RptPeriodTrigger AT (4 15 54 12) LEFTANCHOR
    LIST "Monthly" "Yearly" ID RptPeriodList AT (4 15 54 22) NONUSABLE VISIBLEITEMS 2
    POPUPLIST ID RptPeriodTrigger RptPeriodList
    BUTTON "<" ID RptPrevButton AT (92 15 12 12) NOFRAME
    LABEL "2026 to 2037" ID RptYearLabel AT (106 15) FONT 1
    BUTTON ">" ID RptNextButton AT (140 15 12 12) NOFRAME
    BUTTON "Done" ID RptDoneButton AT (4 146 36 12)
    BUTTON "Graphs" ID RptGraphsButton AT (46 146 40 12)
    BUTTON "Export" ID RptExportButton AT (92 146 40 12)
    SCROLLBAR ID RptScrollBar AT (152 29 7 100) VALUE 0 MIN 0 MAX 0 PAGESIZE 100
END

FORM ID GraphsForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
    TITLE "Graphs"
    POPUPTRIGGER "All vehicles" ID GrVehicleTrigger AT (96 1 62 12) RIGHTANCHOR
    LIST "All vehicles" ID GrVehicleList AT (60 1 98 60) NONUSABLE VISIBLEITEMS 6
    POPUPLIST ID GrVehicleTrigger GrVehicleList
    POPUPTRIGGER "Economy" ID GrKindTrigger AT (4 15 90 12) LEFTANCHOR
    LIST "Economy" "Price per fill" "Spend per month" ID GrKindList AT (4 15 90 33) NONUSABLE VISIBLEITEMS 3
    POPUPLIST ID GrKindTrigger GrKindList
    BUTTON "Done" ID GrDoneButton AT (4 146 36 12)
    BUTTON "Reports" ID GrReportsButton AT (46 146 44 12)
END
